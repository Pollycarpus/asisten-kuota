# Copy to .env. Default = mock LLM: runs with NO API key.
# Switch provider by editing this file only (no code change). See README §3.

APP_PORT=8000
ESB_PORT=8001

# --- Demo-safe / tests: scripted, no network -------------------------
LLM_PROVIDER=mock
LLM_MODEL=mock-scripted
LLM_BASE_URL=
LLM_API_KEY=
LLM_API_VERSION=
LLM_REASONING_EFFORT=
LLM_BILLING=free

# --- Recommended free tier: Google Gemini (OpenAI-compatible) --------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash
# LLM_API_KEY=<your-ai-studio-key>
# LLM_REASONING_EFFORT=low
# LLM_BILLING=free

# --- Production target: Azure OpenAI ----------------------------------
# LLM_PROVIDER=azure_openai
# LLM_BASE_URL=https://<your-resource>.openai.azure.com
# LLM_MODEL=<deployment-name, e.g. gpt-4o-mini>
# LLM_API_VERSION=<GA version from your Azure portal, e.g. 2024-10-21>
# LLM_API_KEY=<azure-key>
# LLM_BILLING=paid

# --- Shared (any provider) -------------------------------------------
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=20
LLM_MAX_TOOL_ITERATIONS=6
# GPT-4o-mini prices: used for the PROJECTED production cost on every provider
PRICE_INPUT_USD_PER_1M=0.15
PRICE_OUTPUT_USD_PER_1M=0.60
FX_IDR_PER_USD=18000
